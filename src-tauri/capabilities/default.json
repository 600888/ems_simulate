{
  "identifier": "default",
  "description": "Default capabilities for EMS Simulate",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "process:allow-exit",
    "process:allow-restart",
    "shell:allow-open",
    "shell:default",
    "allow-get-backend-url",
    "allow-is-backend-ready",
    "allow-restart-backend"
  ]
}
