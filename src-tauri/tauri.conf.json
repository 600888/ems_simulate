{
  "$schema": "https://raw.githubusercontent.com/nickolay/tauri-v2-schemas/main/tauri.conf.schema.json",
  "productName": "EMS Simulate",
  "version": "1.0.0",
  "identifier": "com.emssimulate.desktop",
  "build": {
    "frontendDist": "loading",
    "devUrl": "http://localhost:8991",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EMS Simulate",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "EMS Simulate"
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:8991 http://127.0.0.1:8991; connect-src http://localhost:8991 http://127.0.0.1:8991 ws://localhost:8991 ws://127.0.0.1:8991; img-src 'self' data: http://localhost:8991 http://127.0.0.1:8991; style-src 'self' 'unsafe-inline' http://localhost:8991 http://127.0.0.1:8991;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "createUpdaterArtifacts": false,
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
